# tidbsa demo 环境变量

# Agent9 实例地址（当前使用 staging；本地全栈 docker compose 为 http://localhost:5172）
AGENT9_BASE_URL=https://us-west-2.staging.agent.mem9.ai

# 从 Agent9 Console → API Keys 创建（ag9_uak_ 或 ag9_wak.wak_），必须是完整 token（含最后一段密钥）
AGENT9_API_KEY=

# 工作区项目 id（留空时 seed 脚本自动取第一个项目）
AGENT9_PROJECT_ID=

# Web Console 直接访问 Agent9 时（跨域）用 VITE_ 前缀：
# VITE_AGENT9_BASE_URL=http://localhost:5172
# VITE_AGENT9_API_KEY=
# VITE_AGENT9_PROJECT_ID=

# --- Databend MCP 桥（路径 A，apps/databend-bridge）---
# 桥进程环境变量：pnpm databend:bridge
DATABEND_DSN=databend://user:password@host:443/default?warehouse=default
DATABEND_MCP_SAFE_MODE=true
DATABEND_BRIDGE_BEARER=
DATABEND_MCP_BIND_HOST=127.0.0.1
DATABEND_MCP_BIND_PORT=8001
DATABEND_MCP_MAX_ROWS=200
DATABEND_QUERY_TIMEOUT=300

# --- TiDB Cloud Lake MCP 桥（路径 A，apps/lake-bridge）---
# 桥进程环境变量：pnpm lake:bridge
# DSN 格式：lake://user:password@host:443/database?warehouse=warehouse
LAKE_DSN=lake://user:password@host:443/default?warehouse=default
LAKE_MCP_SAFE_MODE=true
LAKE_BRIDGE_BEARER=
LAKE_MCP_BIND_HOST=127.0.0.1
LAKE_MCP_BIND_PORT=8002
LAKE_MCP_MAX_ROWS=200
LAKE_QUERY_TIMEOUT=300
